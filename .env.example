# Local database. Use Cloud values in Vercel (never localhost).
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6389
FALKORDB_GRAPH=blast_radius
# FALKORDB_USERNAME=default
# FALKORDB_PASSWORD=
# FALKORDB_TLS=true
# Alternative: FALKORDB_URL=rediss://default:password@host:port
# Optional model provider: configure ONE key, never NEXT_PUBLIC_*.
# AI_GATEWAY_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=
# Optional bearer token for /api/mcp; does not protect the public demo UI/API.
# MCP_API_KEY=
# Incident monitoring and protected admin onboarding (32+ random characters each).
# ADMIN_TOKEN=
# MONITOR_TOKEN=
# APP_URL=https://blast-radius-murex.vercel.app
# Email: Resend API key and verified sender. Recipient is set in /setup.
# RESEND_API_KEY=
# ALERT_FROM=Blast Radius <alerts@your-verified-domain.example>
