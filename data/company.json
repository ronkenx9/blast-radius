  "incidents": [
    {
      "id": "INC-2021-07",
      "title": "ua-parser-js hijack: crypto-miner in dashboard build",
      "date": "2021-10-22",
      "services": [
        "web-dashboard"
      ],
      "package": "ua-parser-js",
      "summary": "A compromised publish of ua-parser-js shipped a miner. CI pinned versions saved prod, but the build runners were exposed for 4 hours.",
      "lead": "amara"
    },
    {
      "id": "INC-2022-01",
      "title": "colors.js sabotage broke reporting jobs",
      "date": "2022-01-09",
      "services": [
        "reporting",
        "legacy-cli"
      ],
      "package": "colors",
      "summary": "Maintainer pushed an infinite-loop release. CBN reports were late by a day.",
      "lead": "bisi"
    },
    {
