  "decisions": [
    {
      "id": "ADR-007",
      "title": "Pin all transitive deps with lockfiles + weekly Renovate",
      "by": "zainab",
      "about": [
        "payments-api",
        "auth-service",
        "ledger-core"
      ],
      "packages": [],
      "text": "Every service commits its lockfile. Renovate opens weekly batches; tier-1 services must merge security PRs within 72h."
    },
    {
      "id": "ADR-012",
      "title": "Stay on express 4 until Q3 migration",
      "by": "ada",
      "about": [
        "payments-api",
        "auth-service"
      ],
      "packages": [
        "express"
      ],
      "text": "Express 5 migration deferred; security patches on 4.x must still be applied immediately."
    },
    {
      "id": "ADR-015",
      "title": "Freeze legacy-cli, decommission by 2026",
      "by": "hauwa",
      "about": [
        "legacy-cli"
      ],
      "packages": [
        "event-stream"
      ],
      "text": "No new features. Security fixes only if exploitable; otherwise delete."
    },
    {
      "id": "ADR-019",
      "title": "All outbound HTTP via egress proxy",
      "by": "chidi",
      "about": [
        "fx-rates",
        "kyc-worker",
        "payments-api"
      ],
      "packages": [
        "axios",
        "node-fetch"
      ],
      "text": "Redirects to private ranges are blocked at the proxy, which limits SSRF impact."
    },
    {
      "id": "ADR-021",
      "title": "Rotate JWT signing keys quarterly; RS256 only",
      "by": "ifeoma",
      "about": [
        "auth-service",
        "payments-api"
      ],
      "packages": [
        "jsonwebtoken"
      ],
      "text": "HS256 removed. Library upgrade to jsonwebtoken 9 is a tracked follow-up."
    }
  ]
